# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/artsinly?schema=public"

# Authentication
AUTH_SECRET="artsinly-dev-secret-key-32-chars-minimum-token"
AUTH_URL="http://localhost:3000"

# Image storage provider: "cloudinary" | "s3" | "local"
STORAGE_PROVIDER="cloudinary"

# 1. Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 2. S3-Compatible Object Storage (Cloudflare R2, AWS S3, Supabase, MinIO)
S3_ENDPOINT="" # e.g. "https://<account-id>.r2.cloudflarestorage.com" (leave empty for AWS S3)
S3_REGION="auto" # or "ap-south-1" for AWS
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_PUBLIC_URL="" # e.g. "https://cdn.artsinly.com" or "https://pub-<id>.r2.dev"

# Payments - use sandbox credentials during development
PAYMENT_PROVIDER_KEY_ID=""
PAYMENT_PROVIDER_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Transactional email
EMAIL_API_KEY=""
EMAIL_FROM="orders@artsinly.com"

# Monitoring - optional during initial development
SENTRY_DSN=""
