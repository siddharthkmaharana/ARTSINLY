// ============================================================================
// ARTSINLY DATABASE ARCHITECTURE & STRICT INVARIANTS:
// 
// 1. NON-GUESSABLE IDENTIFIERS:
//    - Use UUIDs or equivalent collision-resistant, non-guessable identifiers
//      for all records (CUID / UUID v4). Auto-incrementing integers (@default(autoincrement()))
//      are strictly forbidden to prevent ID enumeration and resource traversal attacks.
// 
// 2. INTEGER MINOR MONETARY UNITS:
//    - Store money as integer minor units, such as paise for INR (1 INR = 100 paise),
//      or an appropriate exact decimal type.
//    - Floating-point arithmetic and Float types are strictly prohibited for payments,
//      ledger balances, taxes, and settlements to eliminate IEEE 754 precision loss.
// 
// 3. HISTORICAL ORDER IMMUTABILITY (PRICE & SELLER SNAPSHOTTING):
//    - Save the unit price (in integer minor units / paise) and seller (sellerId and
//      seller snapshot metadata) directly on each order item record at purchase time.
//    - Historical orders and order items are immutable audit records: subsequent edits
//      to products (price adjustments, title changes, descriptions, deletion/archival)
//      or changes to seller profiles MUST NEVER alter historical order lines, receipts,
//      commissions, tax computations, or financial ledgers.
// 
// 4. STRICT SEPARATION OF STATUSES:
//    - Keep payment status, order status, and shipment status strictly separate.
//    - Conflating or combining them into a single column is strictly prohibited.
//    - OrderStatus represents the overall contract lifecycle (PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED).
//    - PaymentStatus represents the financial transaction lifecycle (PENDING, AUTHORIZED, COMPLETED, FAILED, REFUNDED).
//    - ShipmentStatus represents the fulfillment & delivery logistics lifecycle (PENDING, LABEL_CREATED, PROCESSING, SHIPPED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, RETURNED).
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// 1. Users
model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  role          Role            @default(BUYER)
  avatar        String?
  phone         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sellerProfile SellerProfile?
  addresses     Address[]
  orders        Order[]
  cart          Cart?
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  reviews       Review[]
  auditLogs     AuditLog[]

  @@map("users")
}

// 2. Seller Profiles
model SellerProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  shopName          String
  slug              String      @unique
  artisanName       String?
  bio               String?     @db.Text
  story             String?     @db.Text
  craftTradition    String
  state             String
  locality          String?
  giCode            String?
  isVerified        Boolean     @default(false)
  yearsOfExperience Int         @default(0)
  bannerUrl         String?
  avatarUrl         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products          Product[]
  orderItems        OrderItem[]
  payouts           Payout[]

  @@map("seller_profiles")
}

// Regional & Provenance Taxonomy
model Region {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  state       String
  description String?   @db.Text
  imageUrl    String?
  createdAt   DateTime  @default(now())

  products    Product[]

  @@map("regions")
}

// Category Taxonomy
model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?     @db.Text
  imageUrl    String?
  parentId    String?
  createdAt   DateTime    @default(now())

  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

// 3. Products
model Product {
  id                String          @id @default(cuid())
  sellerId          String
  categoryId        String
  regionId          String?
  title             String
  slug              String          @unique
  description       String          @db.Text
  story             String?         @db.Text
  craftType         String?
  craftTechnique    String?
  provenanceTag     String?
  giCode            String?
  authenticityDetails String?       @db.Text
  dimensions        String?
  materials         String?
  weight            String?
  shippingWeightGrams Int?
  careInstructions  String?         @db.Text
  basePricePaise    Int             // integer minor units (paise: e.g. 12699 = ₹126.99)
  isMadeToOrder     Boolean         @default(false)
  leadTimeDays      Int             @default(0)
  status            ProductStatus   @default(PUBLISHED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  seller            SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id])
  region            Region?         @relation(fields: [regionId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  inventory         Inventory[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]

  @@map("products")
}

model ProductImage {
  id            String    @id @default(cuid())
  productId     String
  url           String
  altText       String?
  displayOrder  Int       @default(0)
  isPrimary     Boolean   @default(false)

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// 4. Product Variants
model ProductVariant {
  id                  String      @id @default(cuid())
  productId           String
  sku                 String      @unique
  name                String      // e.g. "Raw Terracotta - 14\" H", "Sand Matte Finish"
  colorName           String?     // e.g. "Raw Terracotta"
  colorHex            String?     // e.g. "#8A4B38"
  sizeOption          String?     // e.g. "14\" H × 8\" D"
  materialOption      String?     // e.g. "Natural Terracotta"
  pricePaise          Int         // integer minor units (paise)
  compareAtPricePaise Int?        // original price for strike-through
  isDefault           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory           Inventory?
  cartItems           CartItem[]
  orderItems          OrderItem[]

  @@map("product_variants")
}

// 5. Inventory Tracking
model Inventory {
  id                  String          @id @default(cuid())
  productId           String
  variantId           String?         @unique
  quantity            Int             @default(0) // Available on-hand quantity
  reservedQuantity    Int             @default(0) // Reserved in pending orders/checkouts
  lowStockThreshold   Int             @default(2) // Alert trigger
  sku                 String?
  updatedAt           DateTime        @updatedAt

  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId])
  @@map("inventories")
}

// 6. Carts & Cart Items
model Cart {
  id            String      @id @default(cuid())
  userId        String?     @unique
  sessionToken  String?     @unique // supports guest checkout & persistent browser sessions
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]

  @@map("carts")
}

model CartItem {
  id          String          @id @default(cuid())
  cartId      String
  userId      String?
  productId   String
  variantId   String?
  quantity    Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// 7. Orders & Order Items
model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  buyerId           String
  status            OrderStatus    @default(PENDING)
  paymentStatus     PaymentStatus  @default(PENDING)
  shipmentStatus    ShipmentStatus @default(PENDING)
  currency          String         @default("INR")
  totalPaise        Int
  subtotalPaise     Int
  shippingFeePaise  Int            @default(0)
  taxPaise          Int            @default(0)
  addressSnapshot   Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  buyer             User           @relation(fields: [buyerId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  shipments         Shipment[]

  @@map("orders")
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  productId         String
  variantId         String?
  sellerId          String
  title             String
  pricePaise        Int             // Captured unit price at purchase time (immune to later product edits)
  quantity          Int
  sellerShopName    String?         // Captured seller shop snapshot at purchase time
  sellerArtisanName String?         // Captured artisan name snapshot at purchase time
  productSnapshot   Json?           // Full immutable product snapshot at purchase time
  createdAt         DateTime        @default(now())

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller            SellerProfile   @relation(fields: [sellerId], references: [id])

  @@map("order_items")
}

model Address {
  id            String    @id @default(cuid())
  userId        String
  fullName      String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String    @default("India")
  phone         String
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  provider    String        // razorpay, stripe, etc.
  referenceId String?
  amountPaise Int
  status      PaymentStatus @default(PENDING)
  metadata    Json?
  createdAt   DateTime      @default(now())

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String
  trackingNumber String?
  status         ShipmentStatus @default(LABEL_CREATED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

// 8. Reviews
model Review {
  id                  String    @id @default(cuid())
  productId           String
  buyerId             String
  rating              Int       // 1 to 5
  title               String?
  comment             String?   @db.Text
  isVerifiedPurchase  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer               User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Payout {
  id          String       @id @default(cuid())
  sellerId    String
  amountPaise Int
  status      PayoutStatus @default(PENDING)
  referenceId String?
  createdAt   DateTime     @default(now())

  seller      SellerProfile @relation(fields: [sellerId], references: [id])

  @@map("payouts")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
